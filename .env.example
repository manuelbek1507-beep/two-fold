# Frontend (safe to expose: publishable/anon key only. Security comes from RLS.)
VITE_SUPABASE_URL=https://YOUR-NEW-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Web Push public key (generate: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# ---- Edge Function secrets: set with `supabase secrets set`, NEVER in the frontend ----
# CF_TURN_KEY_ID=...
# CF_TURN_API_TOKEN=...
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
# ALLOWED_ORIGIN=https://your-site.netlify.app   (optional: restrict CORS of turn-credentials)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions by Supabase;
# never copy the service-role key anywhere else.
# PUSH_WEBHOOK_SECRET=long-random-string
